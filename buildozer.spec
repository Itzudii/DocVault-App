[app]

# (str) Title of your application
title = DocVault

# (str) Package name
package.name = docvault

# (str) Package domain
package.domain = com.uditya

# (str) Source code directory
source.dir = .

# (str) Application version
version = 1.0

# (str) List of source file extensions
source.include_exts = py,png,jpg,jpeg,kv,json,atlas

# (str) List of files/folders to exclude
source.exclude_exts = spec

# (str) Python requirements
requirements = python3,kivy,kivymd,plyer

# (str) Presplash
# presplash.filename = assets/presplash.png

# (str) Icon
icon.filename = assets/icon.png

# (str) Supported orientation
orientation = portrait

# (str) Android permissions
android.permissions = READ_MEDIA_IMAGES,READ_MEDIA_VIDEO,READ_MEDIA_AUDIO

# (str) Android API
android.api = 35

# (str) Android minimum API
android.minapi = 23

# (str) Android architecture
android.arch = arm64-v8a

# (str) Android app activity
fullscreen = 0


[buildozer]

# (str) Log level
log_level = 2

# (str) Warning on root
warn_on_root = 1